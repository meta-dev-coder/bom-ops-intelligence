# Copy to .env.local (gitignored). Never commit real values.

# Browser — ships in the bundle; restrict the token in ion to the assets below + allowed URLs.
# Assets: 1 (World Terrain), 96188 (OSM Buildings), 3830186 (Google 2D satellite+labels), 2275207 (Google Photoreal)
VITE_CESIUM_ION_TOKEN=
# MOCK (default, deterministic demo) or LIVE (weather/traffic via the /api proxy where configured)
VITE_DATA_MODE=MOCK
# Override the base imagery ion asset if needed
# VITE_ION_IMAGERY_ASSET_ID=3830186

# Server only — read by the Vite proxy (server/apiPlugin.ts), never exposed to the browser.
# TomTom Traffic Flow; check plan terms + Sahar segment coverage before a client demo.
TOMTOM_API_KEY=
# Open-Meteo: free API is NON-COMMERCIAL only. Use a licensed key for commercial demos,
# or set OPEN_METEO_ALLOW_FREE=true for internal/non-commercial use.
OPEN_METEO_API_KEY=
OPEN_METEO_ALLOW_FREE=false
