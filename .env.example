# Copy to .env.local (gitignored). Never commit real values.

# Browser — ships in the bundle; restrict the token in ion to the assets below + allowed URLs.
# Assets: 1 (World Terrain), 96188 (OSM Buildings), 3830183 (Google 2D satellite+labels), 2275207 (Google Photoreal)
VITE_CESIUM_ION_TOKEN=
# Start mode: MOCK = Simulation (default, deterministic demo) or LIVE = Real data (needs the /api proxy)
VITE_DATA_MODE=MOCK
# Static hosting only (e.g. GitHub Pages): URL of an external /api proxy, ending in '/'. Enables Real mode there.
# VITE_API_BASE=https://bom-proxy.example.workers.dev/
# Override the base imagery ion asset if needed
# VITE_ION_IMAGERY_ASSET_ID=3830183

# Server only — read by the Vite proxy (server/apiPlugin.ts), never exposed to the browser.
# TomTom Traffic Flow; check plan terms + Sahar segment coverage before a client demo.
TOMTOM_API_KEY=
# Real-mode sources that need NO key: weather = METAR VABB (aviationweather.gov),
# aircraft = adsb.lol (ODbL, attribution shown on the map).
# Optional licensed weather instead of METAR:
OPEN_METEO_API_KEY=
# Real BOM arrivals (AeroDataBox). Use a plan that permits commercial use.
AERODATABOX_API_KEY=
# rapidapi (default), apimarket, or direct (AeroDataBox's own Starter/Growth plans)
AERODATABOX_VIA=rapidapi
# direct only — copy both from your AeroDataBox dashboard:
# AERODATABOX_BASE_URL=
# AERODATABOX_KEY_HEADER=
# Flight refresh in seconds (default 900). Starter $19 (40k units): 300 is comfortable.
# AERODATABOX_REFRESH_SECONDS=300
# When the front end is hosted elsewhere (GitHub Pages), allow it to call this proxy:
# API_ALLOWED_ORIGIN=https://meta-dev-coder.github.io
