# /etc/bom-ops/env — root:bomops 640. Each key ONCE (systemd keeps the last value). Never commit real values.
BOM_HTTP_PORT=8096
# scrypt hash from: sudo -u bomops /opt/bom-ops/bin/node /opt/bom-ops/current/server.mjs --hash-password
BOM_DEMO_PASSWORD_HASH=
# BOM_ALLOW_NO_PASSWORD=true      # only for a port open to known IPs

# Real-mode providers (server-side only). METAR weather and adsb.lol aircraft need no key.
AERODATABOX_API_KEY=
AERODATABOX_VIA=direct
AERODATABOX_BASE_URL=
AERODATABOX_KEY_HEADER=
AERODATABOX_REFRESH_SECONDS=300
TOMTOM_API_KEY=
OPEN_METEO_API_KEY=
